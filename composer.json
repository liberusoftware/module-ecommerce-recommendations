{
    "name": "liberusoftware/ecommerce-recommendations",
    "description": "The claim that one product is worth showing next to another and the evidence behind it: derived signals, generation runs, scored affinities per strategy, and the placement a surface was served with its exclusions and its explanation.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": ["laravel", "ecommerce", "recommendations", "liberu"],
    "require": {
        "php": "^8.5",
        "illuminate/config": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Recommendations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Recommendations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-recommendations"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
